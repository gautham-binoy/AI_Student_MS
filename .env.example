# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/database/app.db

# Storage
DATA_DIR=./data

# Face Detection (Ultralytics YOLO)
FACE_MODEL_PATH=models/yolov8n-face.pt
FACE_CONFIDENCE_THRESHOLD=0.50

# Face Recognition & Embeddings
FACE_MATCH_THRESHOLD=0.55

# Attendance Confirmation Logic
MIN_CONFIRMATION_SECONDS=2

# Observable Engagement Estimation Weights
ENGAGEMENT_ORIENTATION_WEIGHT=0.50
ENGAGEMENT_VISIBILITY_WEIGHT=0.30
ENGAGEMENT_PRESENCE_WEIGHT=0.20

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
